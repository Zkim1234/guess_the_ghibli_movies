<!DOCTYPE html>
<html>
  <head>
    <title>Guess The Ghibli Movie</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <div class="hero-container">
      <div class="hero-content">
        <h2 class="game-name">GuessGhibli</h2>
        <img
          src="../images/icons/hero-banner.svg"
          alt="Hero Banner"
          class="hero-banner"
        />
        <h1 class="hero-title">Think you know every Ghibli frame?</h1>
      </div>
    </div>

    <div class="button-container">
      <img
        src="../images/icons/line-left.svg"
        alt="Line Left"
        class="line-left"
      />
      <a href="/level" class="start-button">Start</a>
      <img
        src="../images/icons/line-right.svg"
        alt="Line Right"
        class="line-right"
      />
    </div>
  </body>
</html>
